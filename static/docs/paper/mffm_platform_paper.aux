\newlabel{fig:ui-cond}{{3}{12}{The tool during conditioning, US bloc. Each panel shows history, the baseline (dotted), the scenario (solid), and the uncertainty band; the highlighted panel carries the user's pins, and every other panel updates as they are placed. The left rail holds the scenario controls: long-run targets, external forecasts, the cross-border solve, and the policy counterfactual. Interface view from an earlier release; the layout is unchanged}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}A worked example: a credit-spread shock and its global response}{12}{section.3}\protected@file@percent }
\newlabel{sec:example}{{3}{12}{A worked example: a credit-spread shock and its global response}{section.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}One pin is not a spread shock}{12}{subsection.3.1}\protected@file@percent }
\newlabel{sec:naive}{{3.1}{12}{One pin is not a spread shock}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces One pin is not a spread shock. Deviations from the baseline forecast after conditioning the US bloc on a 100 basis point rise in the Baa corporate yield at the nowcast quarter. With one pin (dashed), the model reads the rise as a broad tightening: the ten-year and two-year Treasury yields and the policy rate rise with it, and output is largely unaffected. Adding a single further condition, the ten-year yield unchanged on impact (solid), turns the same rise into a credit-spread shock: the curve stays put, output contracts, and policy eases. Horizontal axis: quarters from the nowcast.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:naivetrue}{{4}{13}{One pin is not a spread shock. Deviations from the baseline forecast after conditioning the US bloc on a 100 basis point rise in the Baa corporate yield at the nowcast quarter. With one pin (dashed), the model reads the rise as a broad tightening: the ten-year and two-year Treasury yields and the policy rate rise with it, and output is largely unaffected. Adding a single further condition, the ten-year yield unchanged on impact (solid), turns the same rise into a credit-spread shock: the curve stays put, output contracts, and policy eases. Horizontal axis: quarters from the nowcast}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Two pins make a risk shock}{13}{subsection.3.2}\protected@file@percent }
\newlabel{sec:truespread}{{3.2}{13}{Two pins make a risk shock}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces External-balance satellite: the credit-spread scenario's consequence for the US external accounts. Baseline (dashed) and two-pin scenario (solid) paths for the current account and the net international investment position, in percent of GDP. The current account is \emph  {anchored} to its real published value at the nowcast and moves only by the model's real net-export deviation; the net IIP is seeded from its real observed value and rolled forward by the balance-of-payments identity, neither estimated. The scenario improves the current account as the recession compresses imports, and the net-IIP ratio ends above baseline as the stronger balance rebuilds the stock. Horizontal axis: quarters from the nowcast.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:external}{{5}{14}{External-balance satellite: the credit-spread scenario's consequence for the US external accounts. Baseline (dashed) and two-pin scenario (solid) paths for the current account and the net international investment position, in percent of GDP. The current account is \emph {anchored} to its real published value at the nowcast and moves only by the model's real net-export deviation; the net IIP is seeded from its real observed value and rolled forward by the balance-of-payments identity, neither estimated. The scenario improves the current account as the recession compresses imports, and the net-IIP ratio ends above baseline as the stronger balance rebuilds the stock. Horizontal axis: quarters from the nowcast}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}The global response}{14}{subsection.3.3}\protected@file@percent }
\newlabel{sec:globalsolve}{{3.3}{14}{The global response}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The euro-area screen with cross-border spillovers switched on. The scenario was built in the US bloc; the euro-area paths shown here come from the coupled solve. The lower rows are not estimated: the fiscal block follows from the budget identity \eqref  {eq:debt} and the external block from the balance-of-payments identity, so a scenario's debt and current-account consequences appear without further input. Interface view from an earlier release; the layout is unchanged.}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:ui-ea}{{6}{15}{The euro-area screen with cross-border spillovers switched on. The scenario was built in the US bloc; the euro-area paths shown here come from the coupled solve. The lower rows are not estimated: the fiscal block follows from the budget identity \eqref {eq:debt} and the external block from the balance-of-payments identity, so a scenario's debt and current-account consequences appear without further input. Interface view from an earlier release; the layout is unchanged}{figure.6}{}}
