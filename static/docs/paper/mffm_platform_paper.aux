\citation{WielandCwikMuellerSchmidtWolters2012}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The same shock, three ways. Real GDP growth deviations (pp, q/q annualized) under the US credit-spread scenario of Figure~\ref {fig:naivetrue}. The dotted line solves the US bloc on its own, so the rest of the world stays at baseline by construction and world output moves only through the US share. The solid line runs the full coupled solve: the shock travels to the euro area and Japan through trade and financial prices, and their responses feed back. The dashed line imposes the same credit repricing in the United States, the euro area, and Japan at once. World output is the GDP-weighted aggregate over the coupled blocs, using the tool's world weights.}}{16}{figure.7}\protected@file@percent }
\newlabel{fig:global}{{7}{16}{The same shock, three ways. Real GDP growth deviations (pp, q/q annualized) under the US credit-spread scenario of Figure~\ref {fig:naivetrue}. The dotted line solves the US bloc on its own, so the rest of the world stays at baseline by construction and world output moves only through the US share. The solid line runs the full coupled solve: the shock travels to the euro area and Japan through trade and financial prices, and their responses feed back. The dashed line imposes the same credit repricing in the United States, the euro area, and Japan at once. World output is the GDP-weighted aggregate over the coupled blocs, using the tool's world weights}{figure.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}What should policy do?}{16}{subsection.3.4}\protected@file@percent }
\newlabel{sec:counterfactual}{{3.4}{16}{What should policy do?}{subsection.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces What should policy do? The credit-spread scenario (solid) and the same scenario with an unanticipated monetary-policy shock from the Smets--Wouters model layered on top (dashed), sized so that the easing offsets the output trough. Left: the level of real GDP relative to baseline; the counterfactual closes the gap the shock opened. Right: the policy-rate paths. The scenario's own rate falls because the model expects policy to respond; the counterfactual adds the deliberate surprise easing on impact, which then decays along the model's policy rule.}}{17}{figure.8}\protected@file@percent }
\newlabel{fig:cf}{{8}{17}{What should policy do? The credit-spread scenario (solid) and the same scenario with an unanticipated monetary-policy shock from the Smets--Wouters model layered on top (dashed), sized so that the easing offsets the output trough. Left: the level of real GDP relative to baseline; the counterfactual closes the gap the shock opened. Right: the policy-rate paths. The scenario's own rate falls because the model expects policy to respond; the counterfactual adds the deliberate surprise easing on impact, which then decays along the model's policy rule}{figure.8}{}}
